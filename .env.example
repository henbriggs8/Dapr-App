# Copy this file to .env.local on your Mac before running npm run build
# Both values below are PUBLIC (safe to share) — they are embedded in the frontend bundle.

# Get this from dashboard.clerk.com → your app → API Keys → Publishable key
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Your deployed Replit app URL — iOS native app uses this for API calls
# (Web uses relative URLs automatically, so this is only needed for Xcode builds)
VITE_API_BASE_URL=https://dapper-pros.replit.app

# Backend-only Phase 2 vehicle verification settings.
# Configure these as Replit server secrets/variables; never prefix them with VITE_.
# Use the ID of the private App Storage bucket attached to this Repl.
VERIFICATION_MEDIA_BUCKET_ID=replit-objstore-your-private-bucket-id
# Generate an independent cryptographically random value of at least 32 characters.
VERIFICATION_MEDIA_TOKEN_SECRET=replace-with-a-random-server-only-secret
# Keeps production, staging, and development object keys in separate prefixes.
VERIFICATION_MEDIA_ENVIRONMENT=development
