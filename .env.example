# Copy this file to .env.local on your local Mac for Xcode builds
# Get VITE_CLERK_PUBLISHABLE_KEY from dashboard.clerk.com → your app → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Required for iOS Xcode builds — set to your deployed Replit app URL
# so native API calls reach the backend (e.g. https://yourapp.replit.app).
# On web this is not needed — relative URLs work automatically.
VITE_API_BASE_URL=https://autodapper.com
