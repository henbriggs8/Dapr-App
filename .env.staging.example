# TEMPLATE ONLY. Use an approved isolated staging environment; never copy Replit production values.
APP_ENV=staging
NODE_ENV=production
STAGING_ISOLATION_CONFIRMED=false
# Dashboard: bind to the approved project and its staging environment IDs.
STAGING_RAILWAY_PROJECT_ID=replace-with-approved-staging-project-id
STAGING_RAILWAY_ENVIRONMENT_ID=replace-with-staging-environment-id
# Railway supplies RAILWAY_PROJECT_ID and PORT at runtime.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@postgres.railway.internal:5432/dapr_staging
STAGING_DATABASE_HOST=postgres.railway.internal
DATABASE_SSL=disable
# disable is accepted only over private Railway/loopback networking; public TCP needs verify-full + trusted CA.
SESSION_STORE=postgres
SESSION_SECRET=replace-with-a-fresh-random-secret
VERIFICATION_MEDIA_TOKEN_SECRET=replace-with-a-separate-fresh-random-secret
SITE_URL=https://replace-staging-domain.up.railway.app
VITE_API_BASE_URL=https://replace-staging-domain.up.railway.app
# Public build settings must belong to the same isolated development/sandbox accounts.
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_SEPARATE_CLERK_DEVELOPMENT_KEY
VITE_CLERK_ACCOUNT_PORTAL_URL=https://REPLACE_WITH_DEV_INSTANCE.accounts.dev
VITE_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_SAME_INSTANCE_PUBLIC_KEY
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_STRIPE_SANDBOX_KEY
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_SAME_SANDBOX_PUBLIC_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_STAGING_ENDPOINT_SECRET
VITE_GOOGLE_MAPS_API_KEY=
VERIFICATION_MEDIA_BACKEND=s3
VERIFICATION_MEDIA_ENVIRONMENT=staging
S3_BUCKET=dapr-staging-media-REPLACE
S3_ENDPOINT=https://REPLACE_WITH_BUCKET_CREDENTIALS_ENDPOINT
S3_REGION=auto
S3_ACCESS_KEY_ID=REPLACE_WITH_STAGING_BUCKET_KEY
S3_SECRET_ACCESS_KEY=REPLACE_WITH_STAGING_BUCKET_SECRET
# Railway currently defaults to virtual-hosted addressing. Follow the bucket Credentials tab.
S3_FORCE_PATH_STYLE=false
PUSH_NOTIFICATION_ENVIRONMENT=development
OUTBOUND_DELIVERY_MODE=disabled
BOOKING_NOTIFICATION_DISPATCH_ENABLED=false
PROVIDER_NOTIFICATION_DISPATCH_ENABLED=false
SEED_CATALOG_ON_START=false
# Deliberately ABSENT: RESEND_API_KEY, FIREBASE_SERVICE_ACCOUNT_JSON, REPL_ID, REPLIT_DEPLOYMENT.
# Explicit empty-DB initialization only (one-off operator command):
# CONFIRM_EMPTY_STAGING_DATABASE=dapr_staging npm run db:staging:init
